# HTTP/WebSocket listener. Most cloud hosts provide PORT automatically.
PORT=8080

# 0 = no software-level player cap. The real limit is the server's CPU/RAM/network.
MAX_PLAYERS=0

# Set this privately in .env or in your hosting dashboard.
# It must match the creator code you selected for the reserved name "Jika".
# Never commit the real value and never put it in the public browser files.
ADMIN_NAME_CODE=REPLACE_WITH_YOUR_PRIVATE_CREATOR_CODE

# Exact website origins allowed to connect. Use a comma-separated list if needed.
ALLOWED_ORIGINS=https://wandergrandwg.github.io
