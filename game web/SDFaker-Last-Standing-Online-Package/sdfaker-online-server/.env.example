# Copy these values into your hosting provider's environment settings.
PORT=8080
MAX_PLAYERS=32
# Set this to the exact private code used to claim the reserved name "Jika".
# Never put this value in the public HTML or a public repository.
ADMIN_NAME_CODE=CHANGE_THIS_PRIVATE_CODE
# Exact allowed browser origins, comma-separated. The server defaults to the Wandergrand GitHub Pages origin.
# For local browser testing override this with ALLOWED_ORIGINS=http://localhost:8000.
ALLOWED_ORIGINS=https://wandergrandwg.github.io
# Optional persistent record file path. The default is ./data/server-data.json
DATA_FILE=./data/server-data.json
